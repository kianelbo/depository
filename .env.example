# Repository used as the backing store. GitHub.com or a GitHub Enterprise URL.
GITHUB_REPOSITORY_URL=https://github.com/your-account/depository-data
GITHUB_TOKEN=github_pat_xxxxxxxxxxxxxxxxxxxx

# Fine-grained PAT: Contents permission (read and write) for this repository.
# For GitHub Enterprise Server, set its REST API base, e.g. https://github.example.com/api/v3
# GITHUB_API_URL=https://api.github.com

# Shared API key required for all object and link-management endpoints.
# Use a long, random secret. GET /s/:code remains public by design.
DEPOSITORY_API_TOKEN=replace-with-a-long-random-secret

PORT=3000
HOST=0.0.0.0
MAX_UPLOAD_BYTES=104857600
MAX_KEY_BYTES=1024
PUBLIC_BASE_URL=http://localhost:3000
LOG_LEVEL=info
