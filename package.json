{
  "name": "depository",
  "version": "0.1.0",
  "private": true,
  "description": "An object store backed by GitHub Releases.",
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/main.js",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "dotenv": "^18.0.10",
    "fastify": "^5.2.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.19.3",
    "typescript": "^7.0.2"
  }
}
